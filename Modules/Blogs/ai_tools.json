{
  "module": "blogs",
  "version": "1.0.0",
  "tools": [
    {
      "name": "list_blog_posts",
      "method": "GET",
      "endpoint": "/api/blogs",
      "route_name": "api.blogs.index",
      "description": "List published blog posts"
    },
    {
      "name": "create_blog_post",
      "method": "POST",
      "endpoint": "/api/admin/blogs/create-post",
      "route_name": "api.blogs.admin.posts.create-tool",
      "description": "Create a blog post draft"
    },
    {
      "name": "create_blog_category",
      "method": "POST",
      "endpoint": "/api/admin/blogs/create-category",
      "route_name": "api.blogs.admin.categories.create-tool",
      "description": "Create a blog category"
    },
    {
      "name": "publish_blog_post",
      "method": "POST",
      "endpoint": "/api/admin/blogs/publish-post",
      "route_name": "api.blogs.admin.posts.publish-tool",
      "description": "Publish a blog post"
    },
    {
      "name": "create_blog_comment",
      "method": "POST",
      "endpoint": "/api/blogs/{slug}/comments",
      "route_name": "api.blogs.comments.store",
      "description": "Create a comment on a blog post"
    }
  ]
}
